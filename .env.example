# ---------------------------------------------------------------------------
# duerp-attendance service origin.
#
# This is a DIFFERENT service from duerp-api (:8080). Pointing this at duerp-api
# 404s every call — UI_FLOW §8.1 hazard 1.
# ---------------------------------------------------------------------------
VITE_ATTENDANCE_END_POINT=http://localhost:8083

# App credentials checked by ExtAuthMiddleware on EVERY /ext-api call.
# NOTE: VITE_* vars are inlined into the bundle and readable in devtools. These
# are therefore effectively public in any browser client; the server-side IP
# allow-list is the real boundary (UI_FLOW §8.2).
VITE_EXT_APP_ID=
VITE_EXT_APP_PASSWORD=

# Optional. Origin that serves /uploads/... for attendance photo thumbnails.
# Defaults to VITE_ATTENDANCE_END_POINT when unset (UI_FLOW §6.4).
VITE_ATTENDANCE_UPLOADS_ORIGIN=

# ---------------------------------------------------------------------------
# NOT LISTED HERE ON PURPOSE: X-Admin-Key / WOW_ADMIN_KEY.
#
# It is a shared, long-lived admin secret. A VITE_ var ends up in the bundle
# where any end user can read it (UI_FLOW §7.7, §8.2), so the geo-fence screen
# asks the operator to paste the key per session instead. It is held in memory
# for the tab and never written to localStorage or the build.
# ---------------------------------------------------------------------------
